<Window x:Class="YTFolderIcon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Thumbnail → Folder Icon"
        Width="780" Height="660" MinWidth="660" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ الهيدر ============================ -->
        <DockPanel Grid.Row="0" Margin="15,12">
            <!-- اللغة -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="LangLabel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LangCombo" Width="110"/>
            </StackPanel>
            <!-- الثيم -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ThemeCombo" Width="140"/>
            </StackPanel>
            <!-- العنوان -->
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold"
                       FontFamily="Segoe UI, Segoe UI Emoji"
                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource LineBrush}"/>

        <!-- ============================ الجسم ============================ -->
        <StackPanel Grid.Row="2" Margin="15">
            <TextBlock x:Name="UrlsLabel"/>

            <TextBox x:Name="UrlsBox" Height="130" Margin="0,4,0,10"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                     FlowDirection="LeftToRight"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveToLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DestBox" Grid.Column="1" Padding="8,5" FlowDirection="LeftToRight"/>
                <Button x:Name="BrowseBtn" Grid.Column="2" Style="{StaticResource BtnSecondary}"
                        Padding="14,6" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="PlaylistToggle" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox x:Name="ShortsToggle" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RunBtn" Grid.Column="0" Style="{StaticResource BtnSuccess}"
                        Click="Run_Click"/>
                <Button x:Name="PasteBtn" Grid.Column="1" Style="{StaticResource BtnInfo}"
                        Margin="8,0,0,0" Click="Paste_Click"/>
                <Button x:Name="OpenBtn" Grid.Column="2" Style="{StaticResource BtnWarning}"
                        Margin="8,0,0,0" IsEnabled="False" Click="Open_Click"/>
            </Grid>

            <ProgressBar x:Name="Bar" Margin="0,12,0,0" Value="0"/>
        </StackPanel>

        <!-- ============================ السجل ============================ -->
        <GroupBox x:Name="LogGroup" Grid.Row="3" Margin="15,0,15,15">
            <RichTextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         Padding="8,6"/>
        </GroupBox>
    </Grid>
</Window>
